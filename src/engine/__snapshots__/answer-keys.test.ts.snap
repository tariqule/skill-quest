  ],
  "d1-07": [
    "\`failArrow\` is inferred to return \`never\`, but \`failDecl\` is inferred to return \`void\`",
  ],
  "d1-09": [
    "It compiles, then throws a \`TypeError\` at runtime",
  ],
  "d1-10": [
