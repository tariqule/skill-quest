exports[`answer keys code-git > match the reviewed snapshot 1`] = `
{
  "d1-01": [
    "It records snapshots of a project over time, so you can see what changed, who changed it and why, and go back",
  ],
  "d1-02": [
    "Git is the version-control tool on your machine; GitHub hosts Git repositories and adds features like pull requests",
  ],
  "d1-03": [
    "Every clone has the full history, so you can commit, branch and read the log offline",
    "Any clone can serve as a backup of the project's whole history",
  ],
  "d1-05": [
    "A hidden \`.git\` directory that stores the repository's history and settings",
  ],
  "d1-06": [
    "Set the name and email recorded as the author of your future commits, in every repository on this machine",
  ],
  "d1-07": [
    "\`notes.txt\` is untracked: Git sees it but has never been told to track it",
  ],
  "d1-08": [
    "It holds the snapshot your next commit will record, so you choose exactly what goes in",
  ],
  "d1-10": [
    "\`v2\`, the content that was staged",
  ],
  "d1-13": [
    "\`git diff --staged\`",
  ],
  "d1-14": [
    "Git stops listing it as untracked, and \`git add .\` skips it",
  ],
  "d1-15": [
    "It's listed as modified: \`.gitignore\` doesn't affect files Git already tracks",
  ],
  "d1-17": [
    "\`Fix crash when cart is empty\`",
  ],
  "d1-18": [
    "\`9c1e2f7\`",
  ],
  "d1-20": [
    "\`git add forgotten.js\`, then \`git commit --amend --no-edit\`",
  ],
  "d1-21": [
    "Unchanged files point at the same stored blobs as before, so only the changed content (plus a few new tree objects and the commit) is added",
  ],
  "d1-22": [
    "A hash of the commit's content (tree, parents, author, committer, message), so changing any of them gives a different ID",
  ],
  "d1-23": [
    "Every change in the working tree compared with the last commit, staged and unstaged together",
  ],
  "d1-24": [
    "Each commit is one logical change that builds and passes tests",
    "A short imperative summary line, with the reason for the change in the body",
  ],
  "d1-25": [
    "Revoke and rotate the key right away; cleaning it out of history comes after, since others may already have it",
  ],
  "d2-01": [
    "A movable pointer (a name) for a commit",
  ],
  "d2-02": [
    "The branch you have checked out (and, through it, that branch's latest commit)",
  ],
  "d2-03": [
    "\`main\`: \`git branch\` creates a branch but doesn't switch to it",
  ],
  "d2-04": [
    "\`git switch -c login\`",
  ],
  "d2-06": [
    "\`main\` had no new commits since \`feature\` branched off, so Git just moved \`main\` forward to \`feature\`'s tip",
  ],
  "d2-07": [
    "It marks the branch you're on",
  ],
  "d2-09": [
    "Commits reachable from \`feature\` but not from \`main\`: what merging feature would bring in",
  ],
  "d2-10": [
    "\`fc8e15b\` (C5): the merge's second parent, from the branch that was merged in",
  ],
  "d2-11": [
    "\`fd92014\` (C3): first parent, then first parent again",
  ],
  "d2-12": [
    "Its parent commit(s), so history is a graph whose arrows point back in time",
  ],
  "d2-13": [
    "Replays feature's own commits on top of main's latest commit as new commits, giving a straight-line history",
  ],
  "d2-14": [
    "Don't rebase commits that other people already have, because rebasing replaces them with new ones",
  ],
  "d2-16": [
    "They're replaced by new commits D′ and E′ with new IDs; the originals linger, reachable from the reflog, until garbage-collected",
  ],
  "d2-17": [
    "When both branches changed the same part of a file differently, or one edited a file the other deleted",
  ],
  "d2-20": [
    "\`git merge --abort\`",
  ],
  "d2-21": [
    "The version from your feature commit being replayed",
  ],
  "d2-22": [
    "Squash-merge each pull request into main",
  ],
  "d2-23": [
    "History records exactly when and how each branch was integrated",
    "The log can be noisier, though \`git log --first-parent\` shows just the main line",
  ],
  "d2-24": [
    "Integrate small changes into main frequently, using short-lived branches and feature flags for unfinished work",
  ],
  "d3-01": [
    "The default name Git gives the remote you cloned from",
  ],
  "d3-02": [
    "\`fetch\` downloads new commits and updates \`origin/*\` without touching your branch; \`pull\` fetches and then integrates them into your current branch",
  ],
  "d3-04": [
    "It sets \`origin/feature\` as the branch's upstream, so later a plain \`git push\` or \`git pull\` knows where to go",
  ],
  "d3-06": [
    "You have 1 commit origin/main lacks and it has 1 you lack; integrate them (merge or rebase) before a normal push will work",
  ],
  "d3-07": [
    "Pull (merge or rebase) to integrate their commits, then push again",
  ],
  "d3-09": [
    "It refuses if the remote branch has commits you haven't seen, so you can't silently wipe someone else's push",
  ],
  "d3-10": [
    "A remote-tracking branch: your local record of where main was on origin at your last fetch",
  ],
  "d3-11": [
    "A request to merge one branch into another, with a place for review, discussion and automated checks",
